<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF7"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textColor="#2E7D4A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings &amp; Profile"
            android:textColor="#245C3A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About the App"
            android:textColor="#245C3A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvSettingsAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager"
            android:textColor="#333333"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tvSettingsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage pantry ingredients and discover recipes."
            android:textColor="#555555"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:paddingBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Features"
            android:textColor="#245C3A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Add and manage pantry ingredients&#10;• Save ingredients locally&#10;• Discover recipes using available ingredients&#10;• View recipe ingredients and cooking steps"
            android:textColor="#555555"
            android:textSize="16sp"
            android:lineSpacingExtra="8dp"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/tvSettingsVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version 1.0"
            android:textColor="#777777"
            android:textSize="14sp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnBackFromSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Home"
            android:textAllCaps="false"
            android:backgroundTint="#2E7D4A"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
