<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMART PANTRY"
            android:textColor="#237A57"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Add an ingredient"
            android:textColor="#183D2B"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Keep track of what you have in your kitchen."
            android:textColor="#637267"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ingredient name *"
            android:textColor="#183D2B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIngredientName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#237A57"
            android:hint="e.g. Tomatoes"
            android:inputType="textCapWords"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quantity *"
            android:textColor="#183D2B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIngredientQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#237A57"
            android:hint="e.g. 5"
            android:inputType="numberDecimal"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unit *"
            android:textColor="#183D2B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIngredientUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="18dp"
            android:backgroundTint="#237A57"
            android:hint="e.g. pieces, kg, litres"
            android:inputType="textCapSentences"
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Expiry date (optional)"
            android:textColor="#183D2B"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etIngredientExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:backgroundTint="#237A57"
            android:hint="YYYY-MM-DD"
            android:inputType="date"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnSaveIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#237A57"
            android:text="Save ingredient"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCancelIngredient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E0EAE2"
            android:text="Cancel"
            android:textColor="#183D2B" />

    </LinearLayout>
</ScrollView>
